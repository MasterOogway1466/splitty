# Copy to .env for local development. In production these come from the
# Oracle VM's environment (docs/PLAN-PUBLIC.md §3a/§11), never committed.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://splitty:splitty@localhost:5433/splitty_test

# Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-please-this-must-be-at-least-32-chars

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# false in local http dev, true in production behind Caddy/TLS
COOKIE_SECURE=false

# "log" prints emails to the console instead of sending (default, safe for
# local dev/tests). Set "smtp" + SMTP_URL to send for real.
EMAIL_PROVIDER=log
SMTP_URL=
MAIL_FROM="Splitty <no-reply@example.com>"

APP_ORIGIN=http://localhost:5173
