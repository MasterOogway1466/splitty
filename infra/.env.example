# Copy to infra/.env before `docker compose up`. Never commit the real
# file — .gitignore already excludes infra/.env.

POSTGRES_USER=splitty
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=splitty

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# true in production (HTTPS via Caddy); only set false for a pure local
# http:// docker-compose smoke test.
COOKIE_SECURE=true

# "log" prints emails to the container's stdout instead of sending — safe
# default until a real transactional-mail provider is wired up (§9/§16).
# Set "smtp" + SMTP_URL to send for real.
EMAIL_PROVIDER=log
SMTP_URL=
MAIL_FROM="Splitty <no-reply@example.com>"

# The public hostname (docs/PLAN-PUBLIC.md §3b) — used both as the site
# Caddy serves and as the base URL embedded in verification/reset emails.
SITE_ADDRESS=splitty.example.ts.net
APP_ORIGIN=https://splitty.example.ts.net
